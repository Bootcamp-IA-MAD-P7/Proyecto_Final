    "/v1/classes/{class_id}/approve": {
      "post": {
        "summary": "Approve and publish a version of the result",
        "description": "409 `result_version_conflict` when expected_result_version is stale.",
        "operationId": "approveClassResult",
        "security": [
          {
            "bearerToken": []
          }
        ],
        "parameters": [
          {
            "name": "class_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
