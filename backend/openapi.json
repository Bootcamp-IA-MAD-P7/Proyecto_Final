  "components": {
    "schemas": {
      "Analysis": {
        "properties": {
          "general_summary": {
            "type": "string",
            "title": "General Summary"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/AnalysisItem"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "general_summary",
          "items"
        ],
        "title": "Analysis"
      },
      "AnalysisCategory": {
        "type": "string",
        "enum": [
          "vocabulary",
          "grammar",
          "errors_corrections",
          "reinforced_successes",
          "key_concepts",
          "resolved_questions"
        ],
        "title": "AnalysisCategory"
      },
      "AnalysisItem": {
        "properties": {
          "item_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "title": "Item Id"
          },
          "category": {
            "$ref": "#/components/schemas/AnalysisCategory"
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "title": "Content"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "item_id",
          "category",
          "content"
        ],
        "title": "AnalysisItem"
      },
      "ApprovalResponse": {
        "properties": {
          "class_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "title": "Class Id"
          },
          "publication": {
            "$ref": "#/components/schemas/Publication"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "class_id",
          "publication"
        ],
        "title": "ApprovalResponse"
      },
      "ApproveRequest": {
        "properties": {
          "expected_result_version": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Expected Result Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expected_result_version"
        ],
        "title": "ApproveRequest"
      },
      "Body_submitClass": {
        "properties": {
          "audio": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "Audio",
            "description": "Audio of the class"
          },
          "metadata": {
            "type": "string",
            "contentMediaType": "application/json",
            "contentSchema": {
              "$ref": "#/components/schemas/ClassMetadata"
            },
            "title": "Metadata",
            "description": "ClassMetadata serialized as JSON"
          }
        },
        "type": "object",
        "required": [
          "audio",
          "metadata"
        ],
        "title": "Body_submitClass"
      },
      "ClassAccepted": {
        "properties": {
          "class_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "title": "Class Id"
          },
          "job_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "title": "Job Id"
          },
          "state": {
            "$ref": "#/components/schemas/JobState"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "class_id",
          "job_id",
          "state"
        ],
        "title": "ClassAccepted",
        "description": "Response 202 of POST /v1/classes."
      },
      "ClassMetadata": {
        "properties": {
          "external_class_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "title": "External Class Id"
          },
          "participant_count": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Participant Count"
          },
          "participants": {
            "items": {
              "$ref": "#/components/schemas/Participant"
            },
            "type": "array",
            "minItems": 1,
            "title": "Participants"
          },
          "consent_reference": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "title": "Consent Reference"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "external_class_id",
          "participant_count",
          "participants",
          "consent_reference"
        ],
        "title": "ClassMetadata",
        "description": "Metadata sent with the audio of a class (`metadata` part of POST /v1/classes)."
      },
      "DependencyStatus": {
        "type": "string",
        "enum": [
          "ok",
          "unavailable"
        ],
        "title": "DependencyStatus"
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "unauthenticated",
          "forbidden",
          "resource_not_available",
          "invalid_request",
          "invalid_participants",
          "invalid_consent_reference",
          "invalid_review_changes",
          "idempotency_conflict",
          "result_not_ready",
          "result_version_conflict",
          "audio_too_large",
          "unsupported_audio",
          "service_unavailable",
          "internal_error"
        ],
        "title": "ErrorCode"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "title": "Message"
          },
          "retryable": {
            "type": "boolean",
            "title": "Retryable"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "message",
          "retryable"
        ],
        "title": "ErrorDetail"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          },
          "request_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "title": "Request Id",
            "description": "Identifier of the request, for support"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "error",
          "request_id"
        ],
        "title": "ErrorResponse",
        "description": "Body of every error response."
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status"
        ],
        "title": "Health"
      },
      "Job": {
        "properties": {
          "job_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "title": "Job Id"
          },
          "class_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "title": "Class Id"
          },
          "state": {
            "$ref": "#/components/schemas/JobState"
          },
          "stage": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/JobStage"
              },
              {
                "type": "null"
