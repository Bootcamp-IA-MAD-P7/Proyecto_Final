    "/v1/classes/{class_id}/review": {
      "patch": {
        "summary": "Correct the result and create a new version",
        "description": "Each section sent replaces that whole section; absent ones are kept. 409 `result_version_conflict` when expected_result_version is stale; 422 `invalid_review_changes` for an invalid change or reference.",
        "operationId": "reviewClassResult",
        "security": [
          {
            "bearerToken": []
          }
        ],
        "parameters": [
          {
            "name": "class_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "description": "Unknown or malformed ids answer 404",
              "title": "Class Id"
            },
            "description": "Unknown or malformed ids answer 404"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReviewRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Result"
                }
              }
            }
          },
          "401": {
