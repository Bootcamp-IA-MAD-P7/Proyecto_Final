# Variables for running the backend alone, locally or with its own image (CONTRIBUTING §10).
# Copy to .env with `make env`. Never put real secrets here.
# Inside Compose, compose.yaml replaces DATABASE_URL and TEST_DATABASE_URL to use the `db` service.

# PostgreSQL (SQLAlchemy URL). Without it, /ready and /v1 answer 503.
DATABASE_URL=postgresql+psycopg://coteach:coteach@localhost:5432/coteach
# Database of the integration tests: created if missing and emptied by them. Never DATABASE_URL.
# Without it, the PostgreSQL tests are skipped.
TEST_DATABASE_URL=postgresql+psycopg://coteach:coteach@localhost:5432/coteach_test

# Key that signs and verifies tokens (HS256, 32 characters or more). Change it outside development.
AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef
AUTH_AUDIENCE=coteach-ai-api
AUTH_ISSUER=coteach-ai-dev-issuer

# Test issuer POST /dev/token (spec api-access): only with true, never against real users.
# Synthetic users as subject:role (teacher, student or service) and lifetime of their tokens.
AUTH_DEV_ISSUER=true
AUTH_DEV_USERS=demo-teacher:teacher,demo-student:student,coteach-service:service
AUTH_DEV_TOKEN_TTL_SECONDS=3600

# Only origin allowed by CORS: the web (Vite in development).
FRONTEND_ORIGIN=http://localhost:5173

# Background processes (python -m app.worker and python -m app.maintenance).
# Review period before automatic publication (PRD DEC-05: 24 hours, provisional).
REVIEW_PERIOD_HOURS=24
# Wait of the simulated pipeline in each stage, to follow the progress from the web.
FAKE_STAGE_SECONDS=2
# Wait of the worker when the queue is empty or the database is not available.
WORKER_POLL_SECONDS=1
# Attempts of a job whose stages fail for a transient reason, such as a missing model (RNF-05). At most 20.
MAX_ATTEMPTS=3
# Wait before the second attempt; it doubles before each later one (60 s, then 120 s). 0 retries at once.
RETRY_DELAY_SECONDS=60
# Time between two maintenance cycles.
MAINTENANCE_INTERVAL_SECONDS=60

# Reception of the class audio (contract docs/CONTRACTS/coteach-ai-api.md, design of add-class-reception).
# Largest audio in bytes (150 MB) and shortest and longest duration in seconds (1 minute to 2 hours).
UPLOAD_MAX_BYTES=157286400
UPLOAD_MIN_SECONDS=60
UPLOAD_MAX_SECONDS=7200
# Days the original audio is kept before maintenance purges it (RNF-02: 14). Decimals allowed.
AUDIO_RETENTION_DAYS=14
# Private directory of the audio, outside Git. Relative paths start at the working directory.
AUDIO_STORAGE_DIR=data/audio
# Private work copies of each inference attempt. Must be outside AUDIO_STORAGE_DIR so the
# reception purge does not touch them; the worker empties it at start and after each attempt.
WORK_DIR=data/work
# Private cache of the fixed model revisions. Section 2 (ASR) also uses this directory.
MODELS_DIR=data/models
# Hugging Face token to download Community-1 with `make -C backend models`. Never commit a real
# token and never set it in the worker: the pipeline is loaded from MODELS_DIR, without network.
# HF_TOKEN=
# Measurement with `make -C backend measure`: DIARIZATION_MEASURE_AUDIO is a 16 kHz mono WAV.
# DIARIZATION_REFERENCE, when set, is JSON with the expected turns for the DER:
#   {"turns": [{"start_s": 0, "end_s": 1, "speaker": "A"}]}
# DIARIZATION_MEASURE_AUDIO=
# DIARIZATION_REFERENCE=
# DIARIZATION_MAX_SPEAKERS=2
# Transcription with faster-whisper (only the pinned Whisper small is supported in this change).
ASR_MODEL=small
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
ASR_LANGUAGE=
# Measurement of the transcription: ASR_MEASURE_AUDIO is a 16 kHz mono WAV; ASR_REFERENCE is
#   {"text": "expected words"}; ASR_MULTILINGUAL_SAMPLE mixes languages for the comparison.
# ASR_MEASURE_AUDIO=
# ASR_REFERENCE=
# ASR_MULTILINGUAL_SAMPLE=
