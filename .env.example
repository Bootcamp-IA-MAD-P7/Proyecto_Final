# Variables for Docker Compose when running every service together (CONTRIBUTING §10).
# Copy to .env with `make env`. Each service also has its own <service>/.env.example
# for running it alone, locally or with its own image.

COMPOSE_PROJECT_NAME=app

# Port of the backend API on localhost.
BACKEND_PORT=8000

# PostgreSQL of the `db` service; compose.yaml builds the backend DATABASE_URL from them.
POSTGRES_USER=coteach
POSTGRES_PASSWORD=coteach
POSTGRES_DB=coteach

# Test token issuer POST /dev/token with `make up-prod`: false unless you run a local demo.
AUTH_DEV_ISSUER=false

# Port of the frontend web application on localhost.
FRONTEND_PORT=5173
