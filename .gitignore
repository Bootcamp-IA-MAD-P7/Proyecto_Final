# Secrets and local environment: only the .env.example files are versioned
.env
.env.*
!.env.example

# Personal settings of the AI tools (shared settings are versioned)
.claude/settings.local.json
.opencode/*.local.*

# Copies of .agents/skills/ for Claude Code (make claude-skills)
.claude/skills/

# Worktrees of subagents working in parallel
.worktrees/
.claude/worktrees/

# Temporary lock of the OpenSpec CLI while archiving
.openspec-archive.lock

# Local development databases (for example, SQLite)
*.sqlite
*.sqlite3
*.db

# Operating system
.DS_Store
Thumbs.db
