# Basic formatting shared by every editor: https://editorconfig.org
# Each stack adds its own exceptions here (for example, indent_size = 4 for Python).
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# Two trailing spaces are a line break in Markdown.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
